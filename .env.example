# Pick ONE profile: groq, huggingface, ollama, openai or custom.
# Copy this file to .env, set PROFILE, and fill in only that profile's lines.
# No quotes, and no spaces around the "=".
PROFILE=groq

# --- groq (free) ---
GROQ_API_KEY=paste-your-own-key-here

# --- ollama (runs on your own computer, no key needed) ---
# PROFILE=ollama
# (the model name must match one shown by "ollama list")
# SMOL_MODEL=gpt-oss:20b

# --- huggingface (see huggingface.md) ---
# PROFILE=huggingface
# HF_TOKEN=hf_...

# --- openai (paid): a model name is required ---
# PROFILE=openai
# OPENAI_API_KEY=...
# SMOL_MODEL=the-model-name

# --- custom (any service with an OpenAI-style API) ---
# PROFILE=custom
# SMOL_API_BASE=https://.../v1
# SMOL_API_KEY=...
# SMOL_MODEL=the-model-name

# --- optional, for any profile: seconds to wait between steps ---
# SMOL_PAUSE=20
